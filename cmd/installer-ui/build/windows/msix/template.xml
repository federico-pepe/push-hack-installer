<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="installer-ui"
        Arguments=""
        InstallLocation="C:\Program Files\Federico Pepe\Push Hack Installer">
    </Installer>
    <PackageInformation
        PackageName="Push Hack Installer"
        PackageDisplayName="Push Hack Installer"
        PublisherName="CN=Federico Pepe"
        PublisherDisplayName="Federico Pepe"
        Version="0.1.0.0"
        PackageDescription="Installer for push-hack on Ableton Push 3">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.federicopepe.pushhackinstaller"
                Description="Installer for push-hack on Ableton Push 3"
                DisplayName="Push Hack Installer"
                ExecutableName="installer-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Push Hack Installer</DisplayName>
            <PublisherDisplayName>Federico Pepe</PublisherDisplayName>
            <Description>Installer for push-hack on Ableton Push 3</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="installer-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
